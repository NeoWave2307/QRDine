# QRDine Server Configuration
# Copy this file to server/.env and fill in real values before running.
# Never commit the actual server/.env file.

# Port the Express + Socket.IO server listens on (default 3000)
PORT=3000

# Secret key used to generate HMAC-SHA256 payment verification codes.
# Generate a random value with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HASH_SECRET=replace_with_a_random_secret

# Origin allowed by CORS for the student client during development.
# Update to the client's actual dev port if it differs from 8080.
CLIENT_URL=http://localhost:8080